#include "eyelash_corne.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>

&default_transform {
    col-offset = <6>;
};

/ {
    anin0: analog_input_0 {
        compatible = "zmk,analog-input";
        sampling-hz = <100>;
        x-ch {
            io-channels = <&adc 5>; // P0.29 (AIN5)
            mv-mid = <1630>;
            mv-min-max = <1600>;
            mv-deadzone = <80>;
            scale-multiplier = <1>;
            scale-divisor = <70>;
            evt-type = <INPUT_EV_REL>;
            input-code = <INPUT_REL_X>;
        };
        y-ch {
            io-channels = <&adc 0>; // P0.02 (AIN0)
            mv-mid = <1630>;
            mv-min-max = <1600>;
            mv-deadzone = <80>;
            scale-multiplier = <1>;
            scale-divisor = <70>;
            evt-type = <INPUT_EV_REL>;
            input-code = <INPUT_REL_Y>;
        };
    };

    joystick_split: joystick_split {
        compatible = "zmk,input-split";
        device = <&anin0>;
    };
};
