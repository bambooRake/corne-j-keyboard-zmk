#include "eyelash_corne.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>

&default_transform {
    col-offset = <6>;
};

&pwm0 {
    status = "disabled";
};

/ {
    anin0: analog_input_0 {
        compatible = "zmk,analog-input";
        sampling-hz = <10>;

        /* Scan all non-matrix SAADC pins (AIN0..AIN6; AIN7=P0.31 is Row 0) */
        ain0 {
            io-channels = <&adc 0>; // P0.02 (Y)
            mv-mid = <1630>;
            mv-min-max = <1600>;
            mv-deadzone = <80>;
            scale-multiplier = <1>;
            scale-divisor = <1000>;
            evt-type = <INPUT_EV_REL>;
            input-code = <INPUT_REL_Y>;
        };
        ain1 {
            io-channels = <&adc 1>; // P0.03
            mv-mid = <1630>;
            mv-min-max = <1600>;
            mv-deadzone = <80>;
            scale-multiplier = <1>;
            scale-divisor = <2000>;
            evt-type = <INPUT_EV_REL>;
            input-code = <INPUT_REL_X>;
        };
        ain2 {
            io-channels = <&adc 2>; // P0.04
            mv-mid = <1630>;
            mv-min-max = <1600>;
            mv-deadzone = <80>;
            scale-multiplier = <1>;
            scale-divisor = <2000>;
            evt-type = <INPUT_EV_REL>;
            input-code = <INPUT_REL_X>;
        };
        ain3 {
            io-channels = <&adc 3>; // P0.05
            mv-mid = <1630>;
            mv-min-max = <1600>;
            mv-deadzone = <80>;
            scale-multiplier = <1>;
            scale-divisor = <2000>;
            evt-type = <INPUT_EV_REL>;
            input-code = <INPUT_REL_X>;
        };
        ain4 {
            io-channels = <&adc 4>; // P0.28
            mv-mid = <1630>;
            mv-min-max = <1600>;
            mv-deadzone = <80>;
            scale-multiplier = <1>;
            scale-divisor = <2000>;
            evt-type = <INPUT_EV_REL>;
            input-code = <INPUT_REL_X>;
        };
        ain5 {
            io-channels = <&adc 5>; // P0.29 (X)
            mv-mid = <1630>;
            mv-min-max = <1600>;
            mv-deadzone = <80>;
            scale-multiplier = <1>;
            scale-divisor = <1000>;
            evt-type = <INPUT_EV_REL>;
            input-code = <INPUT_REL_X>;
        };
        ain6 {
            io-channels = <&adc 6>; // P0.30
            mv-mid = <1630>;
            mv-min-max = <1600>;
            mv-deadzone = <80>;
            scale-multiplier = <1>;
            scale-divisor = <2000>;
            evt-type = <INPUT_EV_REL>;
            input-code = <INPUT_REL_X>;
        };
    };
};

&joystick_split {
    device = <&anin0>;
};
